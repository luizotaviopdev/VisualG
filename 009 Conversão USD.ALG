Algoritmo "009"
//Faça um algoritmo que leia quanto dinheiro uma pessoa tem na carteira (em R$)
//e mostre quantos dólares ela pode comprar. Considere US$1,00 = R$3,45.
Var

   reais: real

Inicio

   Escreval ("Informe quantos R$ você quer converter em dolar")
   Leia (reais)
   Escreval ("Você pode comprar ", reais/3.45:2:2,"USD")

Fimalgoritmo