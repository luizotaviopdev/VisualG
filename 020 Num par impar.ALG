Algoritmo "020"
//Desenvolva um programa que leia um número inteiro e mostre se ele é PAR ou
//ÍMPAR.
Var

   num: inteiro

Inicio

   Escreval ("Informe um número inteiro")
   Leia (num)

   Se (num % 2 = 0) entao
      Escreval ("O número", num," é um numero par")
   Senao
      Escreval ("O número", num," é um numero ímpar")
   Fimse

Fimalgoritmo