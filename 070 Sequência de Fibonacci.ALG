Algoritmo "070"
//[DESAFIO] Faça um programa que mostre os 10 primeiros elementos da Sequência
//de Fibonacci:
//1 1 2 3 5 8 13 21...
Var

   c, x, y:inteiro

Inicio

   x <- 0
   y <- 1
   Escreva (x)
   Escreva (y)

   Para c de 1 ate 4 faca
   
   x <- x + y
   Escreva (x)
   y <- y + x
   Escreva (y)

   Fimpara
   


Fimalgoritmo