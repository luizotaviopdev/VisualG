Algoritmo "047"
//Desenvolva um aplicativo que mostre na tela o resultado da expressão 500 +
//450 + 400 + 350 + 300 + ... + 50 + 0
Var

   c, z: inteiro

Inicio

   Para c de 450 ate 0 passo -50 faca
   z <- z + c
   Se (c <> 0) entao
   Escreva (c," +")
   Senao
   Escreva (c," =", z)
   Fimse
   Fimpara

Fimalgoritmo