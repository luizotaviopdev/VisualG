Algoritmo "021"
//Faça um algoritmo que leia um determinado ano e mostre se ele é ou não
//BISSEXTO.
Var

   ano: inteiro

Inicio

   Escreval ("Informe um ano")
   Leia (ano)

   Se (ano % 4 = 0) entao
      Escreval (ano," é um ano bissexto")
   Senao
      Escreval (ano," não é um ano bissexto")
   Fimse

Fimalgoritmo