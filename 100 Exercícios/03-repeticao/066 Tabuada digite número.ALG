Algoritmo "066"
//Escreva um programa que leia um número qualquer e mostre a tabuada desse
//número, usando a estrutura “para”.
//Ex: Digite um valor: 5
//5 x 1 = 5
//5 x 2 = 10
//5 x 3 = 15 ...
Var

   c, num: inteiro

Inicio

   Escreval ("Digite um número")
   Leia (num)
   
   Para c de 1 ate 10 faca
   Escreval (num," x", c," =",num * c)
   Fimpara

Fimalgoritmo