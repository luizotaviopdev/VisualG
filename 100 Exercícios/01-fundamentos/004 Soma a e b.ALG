Algoritmo "004"
//Desenvolva um algoritmo que leia dois números inteiros e mostre o somatório
//entre eles.
//Ex:
//Digite um valor: 8
//Digite outro valor: 5
//A soma entre 8 e 5 é igual a 13.
Var

   a, b : inteiro

Inicio

   Escreval ("Informe um número")
   Leia (a)
   Escreval ("Informe outro número")
   Leia (b)
   Escreval ("A soma entre", a," e", b," é igual a", a+b)

Fimalgoritmo