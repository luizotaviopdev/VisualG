Algoritmo "013"
//Faça um algoritmo que leia o salário de um funcionário, calcule e mostre o
//seu novo salário, com 15% de aumento.
Var

   sal: real

Inicio

   Escreval ("Informe o seu salário")
   Leia (sal)
   Escreval ("Esse é seu novo salário reajustado ",sal+(sal*0.15):2:2,"R$")

Fimalgoritmo